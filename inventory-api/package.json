{
  "name": "zk-inventory-api",
  "version": "1.0.0",
  "private": true,
  "description": "Inventory backend: its own PostgreSQL database; reached through the attendance server (one login, one app), talks to attendance only over its API",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "check": "tsc --noEmit",
    "migrate-from-attendance": "tsx scripts/migrate-from-attendance.ts",
    "restore": "tsx scripts/restore-backup.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pdfmake": "^0.3.11",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
