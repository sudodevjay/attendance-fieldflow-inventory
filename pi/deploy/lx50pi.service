[Unit]
Description=LX50 attendance reader (USB -> SQLite -> cloud)
After=network-online.target
Wants=network-online.target

[Service]
User=lx50pi
Group=plugdev
WorkingDirectory=/opt/lx50pi
ExecStart=/opt/lx50pi/venv/bin/python -m lx50pi -c /etc/lx50pi/config.ini run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
